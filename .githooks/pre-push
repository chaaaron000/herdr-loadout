#!/bin/sh
# Blocks a push whose new commits (code, messages, author addresses) contain
# personal data or machine-specific absolute paths. $1 is the remote name.
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue   # deleting a ref pushes no content
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes=$1"  # new ref: everything the remote lacks
  else
    range="$remote_sha..$local_sha"
  fi
  node scripts/check-privacy.mjs --range "$range" || status=1
done
exit $status
